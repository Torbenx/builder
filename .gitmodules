[submodule "libs/EGL"]
	path = libs/EGL
	url = https://github.com/KhronosGroup/EGL-Registry.git
[submodule "libs/OpenGL"]
	path = libs/OpenGL
	url = https://github.com/KhronosGroup/OpenGL-Registry.git
[submodule "libs/abseil"]
	path = libs/abseil
	url = https://github.com/abseil/abseil-cpp.git
